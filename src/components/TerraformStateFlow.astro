---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const copy = lang === 'es'
  ? {
      title: 'Cómo Terraform recupera la propiedad del state',
      previous: 'Paso anterior',
      next: 'Paso siguiente',
      selected: 'Paso seleccionado:',
      steps: [
        ['El recurso remoto existe', 'El proveedor ya conoce el objeto, aunque Terraform todavía no lo administra desde esta dirección.'],
        ['Terraform planea crearlo', 'Al no encontrar ownership en el state, la configuración propone un create que el proveedor rechaza.'],
        ['El import establece ownership', 'Importar vincula el objeto existente con la dirección correcta en el state sin modificar el recurso remoto.'],
        ['El plan revisado reconcilia', 'Un plan revisado confirma que Terraform deja de recrearlo y muestra solo los cambios entendidos.'],
      ],
    }
  : {
      title: 'How Terraform recovers state ownership',
      previous: 'Previous step',
      next: 'Next step',
      selected: 'Selected step:',
      steps: [
        ['Remote resource exists', 'The provider already knows the object, even though Terraform does not yet manage it from this address.'],
        ['Terraform plans to create it', 'Without state ownership, configuration proposes a create that the provider rejects.'],
        ['Import establishes ownership', 'Import links the existing object to the correct state address without modifying the remote resource.'],
        ['Reviewed plan reconciles', 'A reviewed plan confirms Terraform stops recreating it and shows only understood changes.'],
      ],
    };
---

<section class="terraform-state-flow" data-terraform-state-flow aria-labelledby="terraform-state-flow-title">
  <div class="terraform-state-flow__heading">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h16M4 12h16M4 19h10" /></svg>
    <h3 id="terraform-state-flow-title">{copy.title}</h3>
  </div>

  <ol class="terraform-state-flow__steps">
    {copy.steps.map(([title, explanation], index) => (
      <li class="terraform-state-flow__item">
        <button
          type="button"
          class:list={['terraform-state-flow__step', { 'is-selected': index === 0 }]}
          data-step
          data-explanation={explanation}
          aria-current={index === 0 ? 'step' : undefined}
        >
          <span class="terraform-state-flow__number" aria-hidden="true">{index + 1}</span>
          <span class="terraform-state-flow__label">{title}</span>
        </button>
        {index < copy.steps.length - 1 && <span class="terraform-state-flow__arrow" aria-hidden="true">→</span>}
      </li>
    ))}
  </ol>

  <p class="terraform-state-flow__explanation" aria-live="polite">
    <span class="sr-only">{copy.selected} </span><span data-explanation-text>{copy.steps[0][1]}</span>
  </p>

  <div class="terraform-state-flow__controls">
    <button type="button" data-previous>← {copy.previous}</button>
    <button type="button" data-next>{copy.next} →</button>
  </div>
</section>

<style>
  .terraform-state-flow { margin: var(--space-lg) 0; padding: var(--space-md); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-alt); }
  .terraform-state-flow__heading { display: flex; align-items: center; gap: var(--space-sm); }
  .terraform-state-flow__heading svg { width: 1.25rem; flex: 0 0 auto; fill: none; stroke: var(--color-accent); stroke-width: 2; stroke-linecap: round; }
  .terraform-state-flow h3 { margin: 0; font: 600 1.125rem/1.4 var(--font-heading); color: var(--color-fg); }

  .terraform-state-flow__steps { display: flex; align-items: stretch; gap: var(--space-xs); margin: var(--space-md) 0; padding: 0; list-style: none; }
  .terraform-state-flow__item { display: flex; flex: 1; align-items: center; gap: var(--space-xs); min-width: 0; }

  .terraform-state-flow__step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    width: 100%;
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-fg-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .terraform-state-flow__step:hover { border-color: var(--color-border-strong); color: var(--color-fg); }
  .terraform-state-flow__step:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  .terraform-state-flow__step.is-selected { border-color: var(--color-accent); background: var(--color-accent); color: var(--color-bg); }
  .terraform-state-flow__step.is-selected .terraform-state-flow__number { border-color: var(--color-bg); }

  .terraform-state-flow__number { flex: 0 0 auto; display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border: 1px solid currentColor; border-radius: 50%; font: 600 0.75rem/1 var(--font-mono); }
  .terraform-state-flow__label { font-size: 0.875rem; line-height: 1.35; }

  .terraform-state-flow__arrow { flex: 0 0 auto; color: var(--color-fg-subtle); font-size: 0.875rem; }

  .terraform-state-flow__explanation { margin: 0 0 var(--space-md); min-height: 2.7rem; color: var(--color-fg-muted); font-size: 1rem; line-height: 1.6; }

  .terraform-state-flow__controls { display: flex; gap: var(--space-sm); }
  .terraform-state-flow button { min-height: 2.5rem; }
  .terraform-state-flow__controls button { padding: 0.5rem 0.75rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); background: transparent; color: var(--color-fg); font: inherit; cursor: pointer; }
  .terraform-state-flow__controls button:hover { border-color: var(--color-accent); }
  .terraform-state-flow__controls button:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 42rem) {
    .terraform-state-flow__steps { flex-direction: column; }
    .terraform-state-flow__item { flex-direction: column; align-items: stretch; }
    .terraform-state-flow__arrow { align-self: center; transform: rotate(90deg); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .terraform-state-flow__step { transition: border-color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out); }
    .terraform-state-flow__number { transition: border-color var(--duration-fast) var(--ease-out); }
    .terraform-state-flow__explanation[data-updated] { animation: terraform-state-flow-fade var(--duration-normal) var(--ease-out); }
    @keyframes terraform-state-flow-fade {
      from { opacity: 0; transform: translateY(3px); }
      to { opacity: 1; transform: none; }
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-terraform-state-flow]').forEach((flow) => {
    const steps = Array.from(flow.querySelectorAll<HTMLElement>('[data-step]'));
    const explanationWrap = flow.querySelector<HTMLElement>('.terraform-state-flow__explanation');
    const explanation = flow.querySelector<HTMLElement>('[data-explanation-text]');
    let selected = 0;

    const select = (index: number) => {
      selected = (index + steps.length) % steps.length;
      steps.forEach((step, stepIndex) => {
        const isSelected = stepIndex === selected;
        step.classList.toggle('is-selected', isSelected);
        if (isSelected) step.setAttribute('aria-current', 'step');
        else step.removeAttribute('aria-current');
      });
      if (explanation) explanation.textContent = steps[selected].dataset.explanation || '';
      if (explanationWrap) {
        explanationWrap.removeAttribute('data-updated');
        void explanationWrap.offsetWidth;
        explanationWrap.setAttribute('data-updated', '');
      }
    };

    steps.forEach((step, index) => step.addEventListener('click', () => select(index)));
    flow.querySelector('[data-previous]')?.addEventListener('click', () => select(selected - 1));
    flow.querySelector('[data-next]')?.addEventListener('click', () => select(selected + 1));
  });
</script>
